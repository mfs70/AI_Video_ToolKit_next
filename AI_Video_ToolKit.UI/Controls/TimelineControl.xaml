<UserControl x:Class="AI_Video_ToolKit.UI.Controls.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             SizeChanged="UserControl_SizeChanged">

    <Grid Background="#222">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Canvas x:Name="MarkerCanvas"
                Grid.Row="0"
                Height="48"
                Margin="5,0,5,0"
                ClipToBounds="True"
                MouseLeftButtonDown="MarkerCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="MarkerCanvas_MouseLeftButtonUp"
                MouseMove="MarkerCanvas_MouseMove">
            <TextBlock x:Name="InputMarkerLabel"
                       Foreground="LimeGreen"
                       FontSize="10"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>
            <Rectangle x:Name="InputMarker"
                       Width="3"
                       Height="22"
                       Fill="LimeGreen"
                       StrokeThickness="0"
                       Cursor="SizeWE"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="OutputMarkerLabel"
                       Foreground="IndianRed"
                       FontSize="10"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>
            <Rectangle x:Name="OutputMarker"
                       Width="3"
                       Height="22"
                       Fill="IndianRed"
                       StrokeThickness="0"
                       Cursor="SizeWE"
                       Visibility="Collapsed"/>
            <Canvas x:Name="CutMarkerLayer"/>
            <Rectangle x:Name="PlayheadLine"
                       Width="2"
                       Height="22"
                       Fill="#FFD7FFB0"
                       Panel.ZIndex="19"
                       Visibility="Collapsed"/>
            <Border x:Name="FrameCursor"
                    Background="#CC111111"
                    BorderBrush="#FFD7FFB0"
                    BorderThickness="1"
                    CornerRadius="3"
                    MinWidth="48"
                    Padding="4,1"
                    Panel.ZIndex="20"
                    Visibility="Collapsed">
                <TextBlock x:Name="FrameText"
                           Foreground="#FFD7FFB0"
                           FontSize="11"
                           Text="0"/>
            </Border>
        </Canvas>

        <Slider x:Name="Slider"
                Grid.Row="1"
                Minimum="0"
                Maximum="100"
                ValueChanged="Slider_ValueChanged"
                VerticalAlignment="Center"
                Margin="5,0,5,0"/>

        <TextBlock x:Name="TimeText"
                   Grid.Row="2"
                   Foreground="White"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
